{
  "name": "@bencodess/opencode-codemaxxing",
  "version": "0.1.0",
  "description": "An opencode plugin that continuously improves its own project by autonomously injecting improvement prompts until a configurable token/round budget is exhausted.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bencodess/opencode-codemaxxing.git"
  },
  "keywords": [
    "opencode",
    "plugin",
    "autonomous",
    "self-improving",
    "codemaxxing",
    "agents"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.4.10",
    "@opencode-ai/sdk": "^1.4.10",
    "@types/node": "^26.4.0",
    "typescript": "^5.5.0"
  }
}
